    "@aws-sdk/client-ecs": "^3.1165.0",
    "@aws-sdk/client-eventbridge": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1165.0",
    "@gnome-trading-group/gnome-shared-cdk": "^1.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "2.176.0",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1165.0",
    "aws-cdk-lib": "2.176.0",
