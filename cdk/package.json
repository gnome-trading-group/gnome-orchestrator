{
  "name": "cdk",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "test": "jest"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.1165.0",
    "@aws-sdk/client-dynamodb": "^3.1165.0",
